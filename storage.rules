rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBootstrapAdmin() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'techubwenge@gmail.com',
          'uwimbabazigloria05@gmail.com',
          'abdullazackniyigaba@gmail.com'
        ];
    }

    function isAdmin() {
      return request.auth != null &&
        (isBootstrapAdmin() ||
         (request.auth.token.email != null &&
          firestore.exists(/databases/(default)/documents/adminEmails/$(request.auth.token.email.lower()))) ||
         firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }

    function ownsRoom(roomId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.tenantUid == request.auth.uid;
    }

    // Payment proof: the tenant of the room uploads, the tenant and the admin
    // read. A daily function deletes these after 14 days; the submission
    // record of what was paid stays behind in Firestore.
    match /paymentScreenshots/{roomId}/{fileName} {
      allow read: if isAdmin() || ownsRoom(roomId);
      allow create: if ownsRoom(roomId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
