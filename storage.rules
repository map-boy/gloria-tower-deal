rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function email() { return request.auth.token.email.lower(); }
    function hasEmail() { return request.auth != null && request.auth.token.email != null; }

    function isBootstrapAdmin() {
      return hasEmail() && email() in [
        'techubwenge@gmail.com',
        'uwimbabazigloria05@gmail.com',
        'abdullazackniyigaba@gmail.com'
      ];
    }

    function isStaff() {
      return isBootstrapAdmin() ||
        (hasEmail() && firestore.exists(/databases/(default)/documents/staff/$(email())));
    }

    function ownsRoom(roomId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.tenantUid == request.auth.uid;
    }

    // Payment proof. The client of the room uploads it; they and staff read
    // it. A daily job deletes these after 7 days -- the recovery agent
    // downloads what they need to keep before then, and the payment record
    // itself stays in Firestore either way.
    match /paymentProofs/{roomId}/{fileName} {
      allow read: if isStaff() || ownsRoom(roomId);
      allow create: if ownsRoom(roomId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
