rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'tchubwenge@gmail.com';
    }
    function isAdmin() {
      return isSignedIn() &&
        (isBootstrapAdmin() ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function isOwnEmail(email) {
      return isSignedIn() && 'email' in request.auth.token && email == request.auth.token.email.lower();
    }

    match /voltraTower/building {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isAdmin() || isOwnEmail(resource.data.email);
      allow create: if isAdmin() || isOwnEmail(request.resource.data.email);
      allow update: if isAdmin() ||
        (isOwnEmail(resource.data.email) && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    match /usageEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() &&
        (!("amountPaid" in request.resource.data) || request.resource.data.amountPaid == 0);
      allow update: if isAdmin() &&
        request.resource.data.amountPaid == resource.data.amountPaid;
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if false;
      allow write: if isSignedIn();
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /activeSessions/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}