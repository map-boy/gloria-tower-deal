rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function email() { return request.auth.token.email.lower(); }
    function hasEmail() { return isSignedIn() && 'email' in request.auth.token; }

    // Owners of last resort -- cannot be removed from inside the app.
    function isBootstrapAdmin() {
      return hasEmail() && email() in [
        'techubwenge@gmail.com',
        'uwimbabazigloria05@gmail.com',
        'abdullazackniyigaba@gmail.com'
      ];
    }

    function staffRole() {
      return hasEmail() && exists(/databases/$(database)/documents/staff/$(email()))
        ? get(/databases/$(database)/documents/staff/$(email())).data.role
        : '';
    }

    function isAdmin()      { return isBootstrapAdmin() || staffRole() == 'admin'; }
    function isRecovery()   { return isAdmin() || staffRole() == 'recovery'; }
    function isTechnician() { return isAdmin() || staffRole() == 'technician'; }
    function isStaff()      { return isAdmin() || isRecovery() || isTechnician(); }

    function ownsRoom(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.tenantUid == request.auth.uid;
    }

    // Staff directory. Writes go through setStaffRole/removeStaff so built-in
    // owners are protected and roles are validated in one place.
    match /staff/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Prices are public to everyone signed in: a client has to be able to see
    // the rate their own bill was worked out from.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Every staff role needs the whole list of rooms to do its job. A client
    // may read only their own.
    match /rooms/{roomId} {
      allow get: if isStaff() || (isSignedIn() && resource.data.tenantUid == request.auth.uid);
      allow list: if isStaff();
      // Admin edits anything directly; everything else goes through a callable.
      allow write: if isAdmin();
    }

    // Bills are created and settled by callables. A client reads their own.
    match /bills/{billId} {
      allow read: if isStaff() || ownsRoom(resource.data.roomId);
      allow write: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isStaff() || ownsRoom(resource.data.roomId);
      // Marking a thread as seen is the one field staff may touch directly;
      // without it the unread badge would only ever count up.
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByStaff']);
      // Posting goes through postMessage so authorship cannot be forged;
      // admins may still correct the record directly.
      allow create, delete: if isAdmin();
      allow write: if isAdmin();
    }

    // Staff-only alerts. Marking one read is the only client-side write.
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    match /health/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /smsLog/{logId} {
      allow read: if isRecovery();
      allow write: if false;
    }

    // Room passwords. No client reads or writes these, ever.
    match /roomSecrets/{roomId} {
      allow read, write: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if false;
      allow write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
