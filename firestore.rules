rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function isBootstrapAdmin() {
      return isSignedIn() && 'email' in request.auth.token &&
        request.auth.token.email.lower() in ['techubwenge@gmail.com', 'uwimbabazigloria05@gmail.com'];
    }

    // Admin has full rights everywhere below: read anything, edit anything.
    function isAdmin() {
      return isSignedIn() &&
        (isBootstrapAdmin() ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function ownsRoom(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.tenantUid == request.auth.uid;
    }

    // Rooms are created by the claimRoom callable (admin SDK), never by a
    // client write -- that is what keeps two tenants off one room number.
    match /rooms/{roomId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.tenantUid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // A tenant reads and writes only their own submissions. Confirming a
    // payment is admin-only -- a tenant can report, never approve.
    match /submissions/{submissionId} {
      allow read: if isAdmin() || ownsRoom(resource.data.roomId);
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.tenantUid == request.auth.uid &&
         ownsRoom(request.resource.data.roomId) &&
         request.resource.data.status == 'pending' &&
         !('amountConfirmed' in request.resource.data) &&
         !('reviewedBy' in request.resource.data) &&
         request.resource.data.amountReported is number &&
         request.resource.data.amountReported >= 0);
      allow update, delete: if isAdmin();
    }

    // Room passwords. No client reads or writes these, ever -- only the
    // claimRoom and setRoomPassword functions touch them, via the admin SDK.
    match /roomSecrets/{roomId} {
      allow read, write: if false;
    }

    // Written by the onSubmissionCreated function; only admins ever see them.
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /deviceTokens/{tokenId} {
      allow read: if false;
      allow write: if isSignedIn();
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
